---
layout: null
permalink: /content.json
---
[
{%- for post in site.posts -%}
{"title":{{ post.title | jsonify }},"url":{{ post.url | relative_url | jsonify }},"description":{{ post.description | default: post.excerpt | strip_html | truncate: 180 | jsonify }},"date":{{ post.date | date: "%Y-%m-%d" | jsonify }},"readingTime":{{ post.content | number_of_words | divided_by: 200 | plus: 1 | jsonify }},"categories":{{ post.categories | jsonify }},"tags":{{ post.tags | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
